{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "intercambio-navidad-familiar",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "intercambio-navidad",
      "database_id": "REEMPLAZAR_CON_ID_DE_TU_D1"
    }
  ]
}
